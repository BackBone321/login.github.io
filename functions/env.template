# ============================================
# AGRI GUARD - Firebase Functions Environment
# ============================================
# Copy this file to .env and fill in your values

# Gmail Configuration (for OTP emails)
GMAIL_EMAIL=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password

# ============================================
# ORACLE DATABASE CONFIGURATION
# ============================================

# Oracle Database User
ORACLE_USER=your_oracle_username

# Oracle Database Password
ORACLE_PASSWORD=your_oracle_password

# Oracle Connection String
# Format depends on your Oracle setup:

# Option 1: Easy Connect (for local/network Oracle)
# ORACLE_CONNECTION_STRING=hostname:port/service_name
# Example: ORACLE_CONNECTION_STRING=localhost:1521/XEPDB1

# Option 2: TNS Name (if you have tnsnames.ora configured)
# ORACLE_CONNECTION_STRING=your_tns_alias

# Option 3: Oracle Cloud Autonomous Database
# ORACLE_CONNECTION_STRING=(description=(retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1522)(host=adb.region.oraclecloud.com))(connect_data=(service_name=abc123_high.adb.oraclecloud.com))(security=(ssl_server_dn_match=yes)))

# For Oracle Cloud Autonomous DB - Wallet Directory
# Download wallet from Oracle Cloud Console and extract it
# ORACLE_WALLET_DIR=/path/to/wallet

# For Oracle Instant Client (thick mode)
# Download from: https://www.oracle.com/database/technologies/instant-client.html
# ORACLE_CLIENT_DIR=/path/to/instantclient




